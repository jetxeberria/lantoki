#!/bin/bash

# This script cleans up stopped containers, unused images, and unused volumes in Docker.

# Function to remove stopped containers
clean_stopped_containers() {
    echo "Removing stopped containers..."
    docker container prune -f
}

# Function to remove unused images
clean_unused_images() {
    echo "Removing unused images..."
    docker image prune -f
}

# Function to remove all unused images
clean_all_images() {
    echo "Removing all images..."
    docker rmi $(docker images -q) -f
}

# Function to remove unused volumes
clean_unused_volumes() {
    echo "Removing unused volumes..."
    docker volume prune -f
}

# Main cleanup function
cleanup_all() {
    clean_stopped_containers
    clean_unused_images
    clean_unused_volumes
    echo "Docker cleanup completed."
}

# Execute the cleanup function
cleanup_all


