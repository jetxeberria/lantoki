Crear script vault_login.sh:

#!/bin/bash

RESPONSE=$(vault login -method=oidc role="default" --format=json)
echo $RESPONSE | jq

TOKEN=$(echo $RESPONSE | jq -r ".auth.client_token" )
export VAULT_TOKEN=$TOKEN
echo "VAULT_TOKEN: $VAULT_TOKEN"

